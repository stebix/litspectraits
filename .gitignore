# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Local environment / secrets (publisher tokens live here)
.env
.env.local
.env.*.local

# Stray logs from third-party SDKs (e.g. springernature-api-client writes
# api_client.log to cwd on import).
api_client.log

# `litspectraits show-document` defaults to writing `<sha256>.html` into the
# current directory (rendering-mvp-plan.md §4). Anchored to the repo root so a
# render run from here never pollutes the tree; golden HTML lives under
# tests/normalize/golden/ and is unaffected.
/*.html
